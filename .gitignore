# Word geçici/kilit dosyaları
~$*

# Python
__pycache__/
*.pyc
*.pyo

# OS
.DS_Store
Thumbs.db

# Claude çıktı klasörü (repoya girmez — plugin kökünde hiç tutulmaz, bkz. S8)
output/

